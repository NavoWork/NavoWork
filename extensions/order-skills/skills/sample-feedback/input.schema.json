{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "order-skills/sample-feedback/input (domain data only)",
  "$ref": "#/$defs/sampleRequest",
  "$defs": {
    "sampleRequest": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "sample_id": {
          "type": "string",
          "minLength": 1
        },
        "spec_version_id": {
          "type": "string",
          "minLength": 1
        },
        "response": {
          "$ref": "#/$defs/statement"
        },
        "feedback": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feedback"
          }
        }
      },
      "required": [
        "case_id",
        "sample_id",
        "spec_version_id"
      ],
      "additionalProperties": false
    },
    "statement": {
      "type": "object",
      "properties": {
        "decision": {
          "enum": [
            "full",
            "partial",
            "conditional",
            "rejected",
            null
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "version_id": {
          "type": "string",
          "minLength": 1
        },
        "sample_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "feedback": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "requested_change": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "field",
        "observation"
      ],
      "additionalProperties": false
    }
  }
}
