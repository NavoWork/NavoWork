APP_ENV=demo
DATABASE_URL=sqlite:///./data/navowork.sqlite3
GRAPH_CHECKPOINT_DB=./data/agent-checkpoints.sqlite3
WORKBENCH_AGENT_CHECKPOINT_DB=./data/workbench-agent-checkpoints.sqlite3
STORAGE_ROOT=./storage
ALLOWED_ORIGINS=http://127.0.0.1:5173
DEMO_EMAIL=demo@navowork.local
DEMO_PASSWORD=ChangeMe123!
# OpenAI-compatible model for the workbench Agent tool loop.
MODEL_API_KEY=
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com/v1
# An OpenAI-compatible image generation endpoint returning data[].b64_json.
# Blank credentials/model cause an explicit blocked result; no static fallback.
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_SIZE=1024x1024
# BOM recognition uses MODEL_* above; choose a model that accepts image inputs.
# Opt in only when running the live provider acceptance tests (may incur cost).
NAVOWORK_LIVE_RESEARCH=0
