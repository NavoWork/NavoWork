APP_ENV=demo
DATABASE_URL=sqlite:///./data/navowork.sqlite3
GRAPH_CHECKPOINT_DB=./data/agent-checkpoints.sqlite3
STORAGE_ROOT=./storage
ALLOWED_ORIGINS=http://127.0.0.1:5173
DEMO_EMAIL=demo@navowork.local
DEMO_PASSWORD=ChangeMe123!
# Configure a tool-calling model for conversational business tasks.
MODEL_API_KEY=
MODEL_NAME=gpt-6.1-sol
# Optional endpoint for an OpenAI-compatible model service.
MODEL_BASE_URL=
# Conversations use the business Agent by default when a model is configured.
BUSINESS_AGENT=1
# Opt in to actual file tool calling for conversational quotation/change goals.
# No-model execution fails explicitly; it never falls back to a scripted quote.
AGENT_FILE_TOOLS=0
FILE_GRAPH_CHECKPOINT_DB=./data/file-agent-checkpoints.sqlite3
